# ==============================================================================
# AppSec Portfolio Monorepo .gitignore
# ==============================================================================

# Python Bytecode and Caches
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Configurations & Secrets
.env
.env.*
!.env.example

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.nox/
.tox/

# Security Scanners & Build Reports
reports/
*.sarif
*.jsonl

# IDE & Editor Directories
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db

# Build Artifacts & Distribution
dist/
build/
*.egg-info/

# Logs & Databases
*.log
*.sqlite
*.sqlite3

